{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TAV Monitoring - UI + Backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/launch-all.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
