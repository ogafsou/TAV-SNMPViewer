    <svg class="icon-filter-defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="icon-green" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.035 0.38" />
            <feFuncG type="table" tableValues="0.28 0.92" />
            <feFuncB type="table" tableValues="0.13 0.52" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-orange" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.55 1" />
            <feFuncG type="table" tableValues="0.20 0.72" />
            <feFuncB type="table" tableValues="0.015 0.18" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-red" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.48 1" />
            <feFuncG type="table" tableValues="0.025 0.35" />
            <feFuncB type="table" tableValues="0.02 0.30" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-gray" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.25 0.78" />
            <feFuncG type="table" tableValues="0.29 0.83" />
            <feFuncB type="table" tableValues="0.33 0.87" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
      <header class="topbar">
        <div>
          <nav class="tabs" aria-label="Sections">
            <a class="tab<%= page === 'monitoring' ? ' active' : '' %>" href="/monitoring">Monitoring</a>
            <% if (canAccessMonitoringMaps) { %><a id="mapMonitoringLink" class="tab<%= page === 'monitoring-map' ? ' active' : '' %>" href="/monitoring-map">Monitoring Map</a><% } %>
            <% if (canViewMapV2) { %><a id="mapV2Link" class="tab<%= (page === 'map-v2' || page === 'map-v2-edit') ? ' active' : '' %>" href="/map-v2">Map V2</a><% } %>
          </nav>
        </div>
        <div class="topbar-actions" style="display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;justify-content:flex-end;gap:8px;width:auto;">
          <div class="status-pill error" id="connectionStatus" title="Adresse Backend : <%= backend_url %>" style="flex:0 0 auto;width:auto;height:38px;min-height:38px;white-space:nowrap;">Connexion Backend : Erreur</div>
          <button id="toggleMonitoringView" class="icon-monitoring-toggle" type="button" aria-label="Minimiser toutes les cartes" title="Minimiser toutes les cartes" style="flex:0 0 auto;width:auto;height:38px;min-height:38px;white-space:nowrap;"<% if (page !== 'monitoring') { %> hidden<% } %>><img src="/images/Minimize.png" alt="" /></button>
          <button id="refreshMonitoring" class="icon-refresh-button" type="button" aria-label="Rafraîchir toutes les machines" title="Rafraîchir toutes les machines" style="flex:0 0 auto;width:auto;height:38px;min-height:38px;white-space:nowrap;"<% if (page !== 'monitoring' && page !== 'map-v2' && page !== 'map-v2-edit' && page !== 'monitoring-map' && page !== 'monitoring-maps') { %> hidden<% } %>><img src="/images/Refresh.png" alt="" /></button>
          <% if (canAccessConfiguration && page === 'monitoring') { %><a id="openConfiguration" class="icon-mode-switch" href="/configuration" aria-label="Passer en mode configuration" title="Passer en mode configuration"><img src="/images/Configuration.png" alt="" /></a><% } %>
          <% if (page === 'configuration') { %><a id="openMonitoring" class="icon-mode-switch" href="/monitoring" aria-label="Passer en mode monitoring" title="Passer en mode monitoring"><img src="/images/Eye.png" alt="" /></a><% } %>
          <% if (((canAccessMonitoringMaps && page === 'monitoring-map') || (canEditMapV2 && page === 'map-v2'))) { %><a id="openMapConfiguration" class="icon-mode-switch" href="<%= page === 'map-v2' ? '/map-v2/edit' : '/monitoring-maps' %>" aria-label="Configurer les maps" title="Configurer les maps"><img src="/images/Configuration.png" alt="" /></a><% } %>
          <% if (((canAccessMonitoringMaps && page === 'monitoring-maps') || (canEditMapV2 && page === 'map-v2-edit'))) { %><a id="openMapMonitoring" class="icon-mode-switch" href="<%= page === 'map-v2-edit' ? '/map-v2' : '/monitoring-map' %>" aria-label="Revenir au monitoring des maps" title="Revenir au monitoring des maps"><img src="/images/Eye.png" alt="" /></a><% } %>
          <div class="user-menu-control" style="flex:0 0 38px;width:38px;height:38px;">
            <button id="userMenuButton" class="user-menu-button" type="button" style="width:38px;height:38px;min-width:38px;min-height:38px;" aria-label="Menu utilisateur" aria-expanded="false"><img src="/images/User.png?v=20260718-2" width="20" height="20" alt="" /></button>
            <div id="userMenu" class="user-menu" hidden>
              <strong id="currentUserName"></strong>
              <button id="changePasswordButton" type="button">Change password</button>
              <a id="manageUsersLink" href="/users" hidden>Manage User</a>
              <button id="logoutButton" type="button">Logout</button>
            </div>
          </div>
        </div>
      </header>

      <dialog id="passwordDialog" class="password-dialog">
        <form id="passwordForm" method="dialog">
          <h2>Changer le mot de passe</h2>
          <label>Mot de passe actuel<input name="currentPassword" type="password" autocomplete="current-password" required /></label>
          <label>Nouveau mot de passe<input name="newPassword" type="password" minlength="8" autocomplete="new-password" required /></label>
          <p id="passwordError" class="form-error" hidden></p>
          <div class="dialog-actions"><button id="cancelPasswordButton" class="secondary-button" type="button">Annuler</button><button type="submit">Enregistrer</button></div>
        </form>
      </dialog>

   
