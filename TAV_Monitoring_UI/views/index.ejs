      async function initializeApplication() {
        await loadBackendConfig();
        machines = await loadMachines();
        renderMachines();
        renderSelectedMachine();
        renderMonitoringCards();
        await syncMonitoringSnapshot();
      }

      async function loadBackendConfig() {
        try {
          var response = await fetch("/api/config");
          var backendConfig = await response.json();
          if (!response.ok) throw new Error(backendConfig.error || "Configuration backend indisponible");
          REFERENCE_MODE_ENABLED = backendConfig.monitoring_reference_mode === true;
          BACKEND_MONITOR_INTERVAL_S = Number(backendConfig.monitor_interval_s) || 0;
          monitoringReferenceMode.checked = REFERENCE_MODE_ENABLED;
          updateAutoRefreshHint();
        } catch (error) {
          setStatus("Backend indisponible", "error");
        }
      }

      async function loadMachines() {
        try {
          var response = await fetch("/api/machines");
          var parsed = await response.json();

          if (!response.ok) {
            throw new Error(parsed.error || "Impossible de charger les machines");
          }

          return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          setStatus("Chargement impossible", "error");
          return [];
        }
      }

      async function syncMonitoringSnapshot() {
        try {
          var response = await fetch("/api/monitoring");
          var snapshot = await response.json();
          if (!response.ok) throw new Error(snapshot.error || "Monitoring indisponible");
          applyMonitoringSnapshot(snapshot);
        } catch (error) {
          setStatus("Synchronisation impossible", "error");
        }
      }

      function applyMonitoringSnapshot(snapshot) {
        (snapshot.machines || []).forEach(applyMonitoringRecord);
        renderMonitoringCards();
      }

      function applyMonitoringRecord(record) {
        if (!record || !record.machineId) return;
        var previous = monitoringRecords[record.machineId];
        if (previous && Number(previous.revision) > Number(record.revision)) return;
        monitoringRecords[record.machineId] = record;
        monitoringState[record.machineId] = record.view || buildMonitoringState(record.raw || {});
      }

      function setupWebSocket() {
        var protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
        var socket = new WebSocket(protocol + "//" + window.location.host + "/ws");
        socket.addEventListener("message", function(event) {
          try { handleWebSocketMessage(JSON.parse(event.data)); } catch (error) { setStatus("Message WebSocket invalide", "error"); }
        });
        socket.addEventListener("open", function() { setStatus("Temps reel connecte", "ok"); });
        socket.addEventListener("close", function() {
          setStatus("Temps reel deconnecte", "error");
          window.setTimeout(setupWebSocket, 3000);
        });
      }

      function handleWebSocketMessage(message) {
        if (message.type === "monitoring.snapshot") {
          applyMonitoringSnapshot(message);
          return;
        }
        if (message.type === "monitoring.initialized" || message.type === "monitoring.changed") {
          applyMonitoringRecord(message.monitoring);
          renderMonitoringCards();
          return;
        }
        if (message.type === "telemetry.patch") {
          var record = monitoringRecords[message.machineId];
          if (!record || Number(record.revision) > Number(message.revision)) return;
          Object.keys(message.changes || {}).forEach(function(path) { setObjectPath(record.raw, path, message.changes[path]); });
          record.revision = message.revision;
          record.timestamp = message.timestamp;
          if (monitoringState[message.machineId] && message.message) monitoringState[message.machineId].message = message.message;
          if (selectedMachineId === message.machineId && record.raw) renderMonitor(record.raw);
          renderMonitoringCards();
          return;
        }
        if (message.type === "machine.deleted") {
          delete monitoringRecords[message.machineId];
          delete monitoringState[message.machineId];
          renderMonitoringCards();
        }
      }

      function setObjectPath(target, path, value) {
        var keys = String(path).split(".");
        var node = target;
        keys.forEach(function(key, index) {
          if (index === keys.length - 1) {
            if (value === null) delete node[key]; else node[key] = value;
          } else {
            if (!node[key] || typeof node[key] !== "object") node[key] = /^\d+$/.test(keys[index + 1]) ? [] : {};
            node = node[key];
          }
        });
      }

      function renderMachines() {
        machineCount.textContent = String(machines.length);
        machineList.innerHTML = machines.map(function(machine) {
          var source = accessMethodLabel(machine.accessMethod);
          var type = machineTypeLabel(machine.type);
          return '<option value="' + escapeHtml(machine.id) + '">' +
            escapeHtml(machine.name + " - " + type + (normalizeMachineType(machine.type) === "novastar-h" ? " - " + source : "") + " - " + machine.host) +
          "</option>";
        }).join("");

        if (machines.length && !machines.some(function(machine) { return machine.id === selectedMachineId; })) {
          selectedMachineId = machines[0].id;
          localStorage.setItem("novastarSelectedMachineId", selectedMachineId);
        }

        machineList.value = selectedMachineId;
      }

      async function deleteMachine(machineId) {
        var previousMachines = machines.slice();
        var previousSelectedMachineId = selectedMachineId;

        machines = machines.filter(function(machine) {
          return machine.id !== machineId;
        });

        if (selectedMachineId === machineId) {
          selectedMachineId = machines.length ? machines[0].id : "";
          localStorage.setItem("novastarSelectedMachineId", selectedMachineId);
          resetScanResults();
        }

        try {
          var response = await fetch("/api/machines/" + encodeURIComponent(machineId), { method: "DELETE" });
          if (!response.ok) {
            var result = await response.json();
            throw new Error(result.error || "Suppression impossible");
          }
          renderMachines();
          renderSelectedMachine();
          delete monitoringRecords[machineId];
          delete monitoringState[machineId];
          renderMonitoringCards();
          setStatus("Machine supprimee", "ok");
        } catch (error) {
          machines = previousMachines;
          selectedMachineId = previousSelectedMachineId;
          renderMachines();
          renderSelectedMachine();
          setStatus(error.message || "Suppression impossible", "error");
        }
      }

      function renderSelectedMachine() {
        var machine = getSelectedMachine();

        if (!machine) {
          selectedMachineName.textContent = "Aucune machine";
          selectedMachineDetails.textContent = "Selectionnez un equipement H dans la liste.";
          selectedMachineHint.textContent = "Ajoutez une machine pour commencer.";
          scanButton.disabled = true;
          return;
        }

        selectedMachineName.textContent = machine.name;
        var type = normalizeMachineType(machine.type);
        if (type === "kiloview") {
          selectedMachineDetails.textContent = "Kiloview | " + machine.host + " | user: " + (machine.apiUsername || "-");
        } else if (type === "other") {
          selectedMachineDetails.textContent = "Autres | " + machine.host + " | verification par ping";
        } else if (normalizeAccessMethod(machine.accessMethod) === "api") {
          selectedMachineDetails.textContent = machine.host +
            " | API: " + (machine.apiBaseUrl || machine.host) +
            " | user: " + (machine.apiUsername || "admin");
        } else if (normalizeAccessMethod(machine.accessMethod) === "snmp+api") {
          selectedMachineDetails.textContent = machine.host +
            " | SNMP + API (priorite SNMP)" +
            " | user: " + (machine.apiUsername || "admin");
        } else {
          selectedMachineDetails.textContent = machine.host +
            " | lecture: " + machine.readCommunity +
            " | ecriture: " + machine.writeCommunity;
        }
        selectedMachineHint.textContent = "Selection: " + machine.name;
        scanButton.disabled = false;
      }

      function getSelectedMachine() {
        return getMachineById(selectedMachineId);
      }

      function getMachineById(machineId) {
        return machines.find(function(machine) {
          return machine.id === machineId;
        });
      }

