<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= title %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <svg class="icon-filter-defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="icon-green" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.035 0.38" />
            <feFuncG type="table" tableValues="0.28 0.92" />
            <feFuncB type="table" tableValues="0.13 0.52" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-orange" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.55 1" />
            <feFuncG type="table" tableValues="0.20 0.72" />
            <feFuncB type="table" tableValues="0.015 0.18" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-red" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.48 1" />
            <feFuncG type="table" tableValues="0.025 0.35" />
            <feFuncB type="table" tableValues="0.02 0.30" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
        <filter id="icon-gray" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.25 0.78" />
            <feFuncG type="table" tableValues="0.29 0.83" />
            <feFuncB type="table" tableValues="0.33 0.87" />
            <feFuncA type="identity" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <main class="app-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">NovaStar H Series</p>
          <h1>SNMP Viewer</h1>
        </div>
        <div class="status-pill" id="connectionStatus">Pret</div>
      </header>

      <nav class="tabs" aria-label="Sections">
        <button class="tab active" type="button" data-tab="configurationTab">Configuration</button>
        <button class="tab" type="button" data-tab="monitoringTab">Monitoring</button>
      </nav>

      <section id="configurationTab" class="tab-panel active">
      <section class="configuration-options" aria-label="Options du monitoring">
        <label class="reference-mode-option">
          <input id="monitoringReferenceMode" type="checkbox" />
          <span>
            <strong>Mode Set reference</strong>
            <small>Compare chaque scan a un etat de reference defini pour la machine.</small>
          </span>
        </label>
      </section>
      <section class="configuration-layout">
        <aside class="machine-sidebar">
          <div class="add-zone">
            <button id="openAddDialog" type="button">Add</button>
          </div>

          <div class="machine-list-zone">
            <div class="section-title compact">
              <h2>Machines H</h2>
              <span id="machineCount">0</span>
            </div>
            <select id="machineList" class="machine-list" size="12" aria-label="Liste des machines H"></select>
            <p class="sidebar-help" id="selectedMachineHint">Ajoutez une machine pour commencer.</p>
          </div>
        </aside>

        <section class="monitor-zone">
          <div class="monitor-toolbar">
            <div>
              <p class="eyebrow">Machine selectionnee</p>
              <h2 id="selectedMachineName">Aucune machine</h2>
              <span id="selectedMachineDetails">Selectionnez un equipement H dans la liste.</span>
            </div>
            <div class="toolbar-actions">
              <button id="scanButton" type="button" disabled>Scan</button>
            </div>
          </div>

          <section class="summary-grid" id="summaryGrid" aria-live="polite">
            <div class="notice neutral">Selectionnez une machine puis lancez un scan.</div>
          </section>

          <section class="data-section">
            <div class="section-title">
              <h2>Ports de sortie</h2>
              <span id="portCount">0 port</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Slot</th>
                    <th>Port</th>
                    <th>Link</th>
                    <th>Backup</th>
                    <th>Fibre</th>
                    <th>Statut</th>
                  </tr>
                </thead>
                <tbody id="portsTable">
                  <tr><td colspan="6" class="empty">Aucun port de sortie retourne.</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="data-section">
            <div class="section-title">
              <h2>Controleur</h2>
              <span id="lastScan">Aucun scan</span>
            </div>
            <div class="field-grid" id="controllerGrid"></div>
          </section>

          <section class="data-section" id="systemHealthSection" hidden>
            <div class="section-title">
              <h2>Sante systeme</h2>
            </div>
            <div class="field-grid" id="systemHealthGrid"></div>
          </section>

          <section class="data-section" id="mvrSection" hidden>
            <div class="section-title">
              <h2>Cartes MVR</h2>
              <span id="mvrCount">0 carte</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead><tr><th>Slot</th><th>Modele</th><th>Serie</th><th>Statut</th><th>Resolution</th><th>Interfaces</th></tr></thead>
                <tbody id="mvrTable"><tr><td colspan="6" class="empty">Aucune carte MVR retournee.</td></tr></tbody>
              </table>
            </div>
          </section>

          <section class="data-section" id="mvrVideoSection" hidden>
            <div class="section-title"><h2>Video MVR</h2></div>
            <div class="field-grid" id="mvrVideoGrid"></div>
          </section>

          <section class="data-section" id="usbSection" hidden>
            <div class="section-title"><h2>USB</h2></div>
            <div class="table-wrap"><table><thead><tr><th>Port</th><th>Statut</th></tr></thead><tbody id="usbTable"></tbody></table></div>
          </section>

          <section class="data-section" id="fansSection" hidden>
            <div class="section-title"><h2>Ventilateurs</h2></div>
            <div class="table-wrap"><table><thead><tr><th>Ventilateur</th><th>Statut</th></tr></thead><tbody id="fansTable"></tbody></table></div>
          </section>

          <section class="data-section" id="powerSection" hidden>
            <div class="section-title"><h2>Alimentations</h2></div>
            <div class="table-wrap"><table><thead><tr><th>Alimentation</th><th>Statut</th></tr></thead><tbody id="powerTable"></tbody></table></div>
          </section>

          <section class="data-section">
            <div class="section-title">
              <h2>Slots d'entree</h2>
              <span id="slotCount">0 slot</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Slot</th>
                    <th>Statut</th>
                    <th>Firmware</th>
                    <th>Serie</th>
                    <th>Sources</th>
                    <th>Source active</th>
                  </tr>
                </thead>
                <tbody id="slotsTable">
                  <tr><td colspan="6" class="empty">Lancez un scan pour lire les slots d'entree.</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="data-section">
            <div class="section-title">
              <h2>Ecrans</h2>
              <span id="screenCount">0 ecran</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Ecran</th>
                    <th>Nom</th>
                    <th>Resolution</th>
                    <th>Frequence</th>
                    <th>Luminosite</th>
                    <th>Mode</th>
                  </tr>
                </thead>
                <tbody id="screensTable">
                  <tr><td colspan="6" class="empty">Lancez un scan pour lire les ecrans.</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="data-section">
            <div class="section-title">
              <h2 id="cardsTitle">Receiving cards</h2>
              <span id="cardCount">Optionnel</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Slot</th>
                    <th>Port</th>
                    <th>Card</th>
                    <th>Link</th>
                    <th>Travail</th>
                    <th>Temp.</th>
                    <th>Voltage</th>
                    <th>Versions</th>
                  </tr>
                </thead>
                <tbody id="cardsTable">
                  <tr><td colspan="8" class="empty">Activez la lecture receiving cards dans la configuration machine.</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </section>
      </section>
      </section>

      <section id="monitoringTab" class="tab-panel" hidden>
        <div class="monitoring-header">
          <div>
            <p class="eyebrow">Vue globale</p>
            <h2>Monitoring</h2>
            <span id="monitoringHint">Les cartes utilisent la liste des machines configurees.</span>
            <span id="autoRefreshHint"></span>
          </div>
          <button id="refreshMonitoring" type="button">Refresh</button>
        </div>

        <div id="monitoringCards" class="monitoring-grid">
          <div class="notice neutral">Ajoutez des machines dans Configuration pour alimenter le monitoring.</div>
        </div>
      </section>
    </main>

    <div id="machineContextMenu" class="context-menu" hidden>
      <button id="editMachine" type="button">Edit</button>
      <button id="deleteMachine" type="button">Delete</button>
    </div>

    <div id="dialogBackdrop" class="dialog-backdrop" hidden>
      <section class="dialog" role="dialog" aria-modal="true" aria-labelledby="dialogTitle">
        <div class="section-title">
          <h2 id="dialogTitle">Ajouter une machine</h2>
          <button id="closeAddDialog" class="ghost-button" type="button">Fermer</button>
        </div>

        <form id="machineForm" class="machine-form">
          <div class="machine-form-row identity-row">
            <label>
              <span>Type</span>
              <select name="type">
                <option value="novastar-h">NovaStar H</option>
                <option value="kiloview">Kiloview</option>
                <option value="other">Autres</option>
              </select>
            </label>

            <label>
              <span>Nom</span>
              <input name="name" type="text" placeholder="H9 Regie principale" autocomplete="off" required />
            </label>

            <label>
              <span>Adresse IP</span>
              <input name="host" type="text" value="192.168.1.10" autocomplete="off" required />
            </label>
          </div>

          <div class="machine-form-row credentials-row api-field" hidden>
            <label class="credential-field">
              <span>Utilisateur API</span>
              <input name="apiUsername" type="text" value="admin" autocomplete="off" />
            </label>

            <label class="credential-field">
              <span>Mot de passe API</span>
              <input name="apiPassword" type="password" value="admin" autocomplete="new-password" />
            </label>
          </div>

          <fieldset class="access-mode-field novastar-only">
            <legend>Source des infos</legend>
            <label class="toggle-row">
              <input name="accessMethod" type="radio" value="snmp" checked />
              <span>SNMP</span>
            </label>
            <label class="toggle-row">
              <input name="accessMethod" type="radio" value="api" />
              <span>API NovaStar H</span>
            </label>
            <label class="toggle-row">
              <input name="accessMethod" type="radio" value="snmp+api" />
              <span>SNMP + API</span>
            </label>
          </fieldset>

          <details class="advanced-settings novastar-only">
            <summary>Parametres avances</summary>
            <div class="advanced-settings-grid">
              <label class="snmp-field">
                <span>Lecture</span>
                <input name="readCommunity" type="text" value="public" autocomplete="off" />
              </label>
              <label class="snmp-field">
                <span>Ecriture</span>
                <input name="writeCommunity" type="text" value="private" autocomplete="off" />
              </label>
              <label class="shared-field">
                <span>Timeout ms</span>
                <input name="timeout" type="number" min="500" max="10000" step="100" value="2000" />
              </label>
              <label class="snmp-field">
                <span>Retries</span>
                <input name="retries" type="number" min="0" max="5" step="1" value="1" />
              </label>
              <label class="api-field" hidden>
                <span>URL API</span>
                <input name="apiBaseUrl" type="text" placeholder="http://192.168.69.86" autocomplete="off" />
              </label>
              <label class="api-field" hidden>
                <span>Device ID</span>
                <input name="apiDeviceId" type="number" min="0" max="999" step="1" value="0" />
              </label>
              <label class="snmp-field">
                <span>Slots d'entree max</span>
                <input name="maxInputSlots" type="number" min="1" max="32" placeholder="auto" />
              </label>
              <label class="snmp-field">
                <span>Ecrans max</span>
                <input name="maxScreens" type="number" min="1" max="16" placeholder="auto" />
              </label>
              <label class="snmp-field">
                <span>Receiving cards / port</span>
                <input name="recvCardsPerPort" type="number" min="1" max="12" value="1" />
              </label>
              <label class="toggle-row snmp-field">
                <input name="includeReceivingCards" type="checkbox" />
                <span>Lire les receiving cards</span>
              </label>
            </div>
          </details>

          <div class="dialog-actions">
            <button class="secondary-button" id="cancelAddDialog" type="button">Annuler</button>
            <button type="submit">OK</button>
          </div>
        </form>
      </section>
    </div>

    <script>
      var LEGACY_STORAGE_KEY = "novastarMachines";
      var AUTOREFRESH_S = Number(<%- JSON.stringify(rest_refresh_s || 0) %>) || 0;
      var REFERENCE_MODE_ENABLED = false;
      var BACKEND_MONITOR_INTERVAL_S = 0;
      var machines = [];
      var selectedMachineId = localStorage.getItem("novastarSelectedMachineId") || "";
      var contextMachineId = "";
      var editingMachineId = "";
      var monitoringState = {};
      var monitoringRecords = {};
      var activeTabId = "configurationTab";
      var monitoringRefreshInProgress = false;
      var autoRefreshTimer = null;

      var machineList = document.getElementById("machineList");
      var machineCount = document.getElementById("machineCount");
      var selectedMachineName = document.getElementById("selectedMachineName");
      var selectedMachineDetails = document.getElementById("selectedMachineDetails");
      var selectedMachineHint = document.getElementById("selectedMachineHint");
      var scanButton = document.getElementById("scanButton");
      var statusNode = document.getElementById("connectionStatus");
      var dialogBackdrop = document.getElementById("dialogBackdrop");
      var machineForm = document.getElementById("machineForm");
      var dialogTitle = document.getElementById("dialogTitle");
      var contextMenu = document.getElementById("machineContextMenu");
      var editMachineButton = document.getElementById("editMachine");
      var deleteMachineButton = document.getElementById("deleteMachine");
      var monitoringCards = document.getElementById("monitoringCards");
      var refreshMonitoringButton = document.getElementById("refreshMonitoring");
      var autoRefreshHint = document.getElementById("autoRefreshHint");
      var monitoringReferenceMode = document.getElementById("monitoringReferenceMode");

      document.querySelectorAll(".tab").forEach(function(tabButton) {
        tabButton.addEventListener("click", function() {
          activateTab(tabButton.dataset.tab);
        });
      });

      document.getElementById("openAddDialog").addEventListener("click", openAddDialog);
      document.getElementById("closeAddDialog").addEventListener("click", closeDialog);
      document.getElementById("cancelAddDialog").addEventListener("click", closeDialog);
      machineForm.elements.type.addEventListener("change", updateMachineFormFields);
      machineForm.host.addEventListener("input", function() {
        if (getSelectedAccessMethod() !== "snmp") {
          machineForm.apiBaseUrl.value = machineForm.host.value
            ? "http://" + machineForm.host.value.replace(/^https?:\/\//, "")
            : "";
        }
      });
      document.querySelectorAll('input[name="accessMethod"]').forEach(function(accessInput) {
        accessInput.addEventListener("change", updateAccessModeFields);
      });
      dialogBackdrop.addEventListener("click", function(event) {
        if (event.target === dialogBackdrop) {
          closeDialog();
        }
      });

      machineList.addEventListener("change", function() {
        selectedMachineId = machineList.value;
        localStorage.setItem("novastarSelectedMachineId", selectedMachineId);
        renderSelectedMachine();
        resetScanResults();
      });

      machineList.addEventListener("contextmenu", function(event) {
        event.preventDefault();

        if (!machines.length) {
          return;
        }

        if (event.target && event.target.value) {
          selectedMachineId = event.target.value;
          machineList.value = selectedMachineId;
          localStorage.setItem("novastarSelectedMachineId", selectedMachineId);
          renderSelectedMachine();
          resetScanResults();
        }

        contextMachineId = selectedMachineId;
        openContextMenu(event.clientX, event.clientY);
      });

      document.addEventListener("click", function(event) {
        if (!contextMenu.hidden && !contextMenu.contains(event.target)) {
          closeContextMenu();
        }
      });

      editMachineButton.addEventListener("click", function() {
        var machine = getMachineById(contextMachineId);
        closeContextMenu();

        if (machine) {
          openEditDialog(machine);
        }
      });

      deleteMachineButton.addEventListener("click", function() {
        var machine = getMachineById(contextMachineId);
        closeContextMenu();

        if (machine) {
          deleteMachine(machine.id);
        }
      });

      machineForm.addEventListener("submit", async function(event) {
        event.preventDefault();

        var formData = new FormData(machineForm);
        var editedMachine = editingMachineId ? getMachineById(editingMachineId) : null;
        var machine = {
          id: editingMachineId || String(Date.now()),
          type: normalizeMachineType(formData.get("type")),
          name: String(formData.get("name") || "").trim(),
          host: String(formData.get("host") || "").trim(),
          accessMethod: normalizeAccessMethod(formData.get("accessMethod")),
          readCommunity: String(formData.get("readCommunity") || "public").trim() || "public",
          writeCommunity: String(formData.get("writeCommunity") || "private").trim() || "private",
          timeout: String(formData.get("timeout") || "2000"),
          retries: String(formData.get("retries") || "1"),
          apiBaseUrl: String(formData.get("apiBaseUrl") || "").trim(),
          apiUsername: String(formData.get("apiUsername") || "admin").trim() || "admin",
          apiPassword: String(formData.get("apiPassword") || ""),
          apiDeviceId: String(formData.get("apiDeviceId") || "0"),
          maxOutputSlots: String(formData.get("maxOutputSlots") || ""),
          maxScreens: String(formData.get("maxScreens") || ""),
          maxInputSlots: String(formData.get("maxInputSlots") || ""),
          recvCardsPerPort: String(formData.get("recvCardsPerPort") || "1"),
          includeReceivingCards: machineForm.includeReceivingCards.checked
        };

        if (machine.type === "kiloview") {
          delete machine.accessMethod;
          delete machine.readCommunity;
          delete machine.writeCommunity;
          delete machine.apiBaseUrl;
          delete machine.apiDeviceId;
          delete machine.retries;
          delete machine.maxOutputSlots;
          delete machine.maxScreens;
          delete machine.maxInputSlots;
          delete machine.recvCardsPerPort;
          delete machine.includeReceivingCards;
        } else if (machine.type === "other") {
          machine = { id: machine.id, type: machine.type, name: machine.name, host: machine.host, timeout: machine.timeout };
        }

        if (machine.type === "novastar-h" && machine.accessMethod !== "snmp" && !machine.apiBaseUrl) {
          machine.apiBaseUrl = machine.host ? "http://" + machine.host.replace(/^https?:\/\//, "") : "";
        }

        if (editedMachine && editedMachine.monitoringReference) {
          machine.monitoringReference = editedMachine.monitoringReference;
        }

        if (editedMachine) {
          if (!String(formData.get("readCommunity") || "").trim()) delete machine.readCommunity;
          if (!String(formData.get("writeCommunity") || "").trim()) delete machine.writeCommunity;
          if (!String(formData.get("apiPassword") || "")) delete machine.apiPassword;
          delete machine.monitoringReference;
        }

        if (!machine.name || !machine.host) {
          setStatus("Configuration incomplete", "error");
          return;
        }

        var wasEditing = !!editingMachineId;
        try {
          var endpoint = wasEditing ? "/api/machines/" + encodeURIComponent(editingMachineId) : "/api/machines";
          var response = await fetch(endpoint, {
            method: wasEditing ? "PATCH" : "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(machine)
          });
          var result = await response.json();
          if (!response.ok) throw new Error(result.error || "Impossible de sauvegarder la machine");
          if (wasEditing) {
            machines = machines.map(function(existingMachine) { return existingMachine.id === result.machine.id ? result.machine : existingMachine; });
          } else {
            machines.push(result.machine);
          }
          selectedMachineId = result.machine.id;
          if (result.monitoring) applyMonitoringRecord(result.monitoring);
          localStorage.setItem("novastarSelectedMachineId", selectedMachineId);
          renderMachines();
          renderSelectedMachine();
          renderMonitoringCards();
          resetScanResults();
          closeDialog();
          setStatus(wasEditing ? "Machine modifiee" : "Machine ajoutee", "ok");
        } catch (error) {
          setStatus(error.message || "Sauvegarde impossible", "error");
        }
      });

      scanButton.addEventListener("click", async function() {
        var machine = getSelectedMachine();

        if (!machine) {
          setStatus("Aucune machine", "error");
          return;
        }

        setStatus("Scan en cours", "busy");
        scanButton.disabled = true;
        monitoringState[machine.id] = buildTransientMonitoringState(machine, "pending", "Scan", "Scan en cours");
        renderMonitoringCards();

        try {
          var response = await fetch("/api/machines/" + encodeURIComponent(machine.id) + "/scan", { method: "POST" });
          var record = await response.json();

          if (!response.ok) {
            throw new Error(record.error || "Erreur de scan");
          }

          applyMonitoringRecord(record);
          if (!record.view || !record.view.connected) throw new Error(record.raw && record.raw.error || "Equipement non connecte");
          renderMonitor(record.raw);
          renderMonitoringCards();
          setStatus("Connecte", "ok");
        } catch (error) {
          setStatus("Erreur", "error");
          renderError(error.message);
          monitoringState[machine.id] = buildTransientMonitoringState(machine, "offline", "Offline", error.message || "Equipement non connecte.");
          renderMonitoringCards();
        } finally {
          scanButton.disabled = !getSelectedMachine();
        }
      });

      refreshMonitoringButton.addEventListener("click", function() {
        refreshMonitoring(true);
      });

      monitoringReferenceMode.addEventListener("change", async function() {
        var requestedMode = monitoringReferenceMode.checked;
        monitoringReferenceMode.disabled = true;

        try {
          var response = await fetch("/api/config/monitoring-reference-mode", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ enabled: requestedMode })
          });
          var result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || "Impossible de sauvegarder le mode de monitoring");
          }

          REFERENCE_MODE_ENABLED = result.enabled === true;
          monitoringReferenceMode.checked = REFERENCE_MODE_ENABLED;
          renderMonitoringCards();
          updateAutoRefreshHint();
          setStatus(REFERENCE_MODE_ENABLED ? "Mode reference active" : "Mode actuel actif", "ok");
        } catch (error) {
          monitoringReferenceMode.checked = REFERENCE_MODE_ENABLED;
          setStatus("Sauvegarde impossible", "error");
        } finally {
          monitoringReferenceMode.disabled = false;
        }
      });

      monitoringCards.addEventListener("click", function(event) {
        var button = event.target.closest(".set-reference-button");
        if (button) {
          setMachineReference(button.dataset.machineId);
        }
      });

      initializeApplication();
      setupRestRefresh();
      setupWebSocket();

      async function refreshMonitoring(manual) {
        if (!machines.length) {
          setStatus("Aucune machine", "error");
          return;
        }

        if (monitoringRefreshInProgress) {
          return;
        }

        monitoringRefreshInProgress = true;
        refreshMonitoringButton.disabled = true;
        setStatus(manual ? "Monitoring" : "Auto refresh", "busy");

        var refreshSucceeded = false;
        try {
          machines.forEach(function(machine) {
            monitoringState[machine.id] = buildTransientMonitoringState(machine, "pending", "Scan", "Scan en cours");
          });
          renderMonitoringCards();
          var response = await fetch("/api/monitoring/scan", { method: "POST" });
          var snapshot = await response.json();
          if (!response.ok) throw new Error(snapshot.error || "Erreur de scan");
          applyMonitoringSnapshot(snapshot);
          refreshSucceeded = true;
        } catch (error) {
          setStatus(error.message || "Erreur de scan", "error");
        } finally {
          refreshMonitoringButton.disabled = false;
          monitoringRefreshInProgress = false;
          if (refreshSucceeded) setStatus("Monitoring OK", "ok");
