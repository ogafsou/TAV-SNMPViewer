<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= title %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/stylesheets/style.css?v=20260723-27" />
  </head>
  <body data-rest-refresh-s="<%= rest_refresh_s || 0 %>" data-backend-url="<%= backend_url %>" style="--map-background-opacity:<%= bkgnd_opacity %>">
    <main class="app-shell">
      <%- include("partials/shared/header") %>
      <%- include("Configuration") %>
      <%- include("Monitoring") %>
      <% if (canAccessMonitoringMaps) { %><%- include("MonitoringMaps") %><% } %>
      <%- include("Users") %>
    </main>

    <dialog id="monitoringCardDialog" class="monitoring-card-dialog">
      <div class="monitoring-card-dialog-head">
        <strong>Detail de la machine</strong>
        <button id="closeMonitoringCardDialog" class="ghost-button" type="button">Fermer</button>
      </div>
      <div id="monitoringCardDialogContent"></div>
    </dialog>

    <%- include("partials/configuration/machine-actions") %>

    <script src="/javascripts/auth.js?v=20260723-1"></script>
    <script src="/javascripts/utils.js?v=20260723-2"></script>
    <script src="/javascripts/monitoring-renderers.js?v=20260723-9"></script>
    <script src="/javascripts/machine-details.js?v=20260723-6"></script>
    <script src="/javascripts/monitoring.js?v=20260723-9"></script>
    <script src="/javascripts/configuration.js?v=20260723-9"></script>
    <% if (canAccessMonitoringMaps) { %><script src="/javascripts/monitoring-maps.js?v=20260723-10"></script><% } %>
    <script src="/javascripts/application.js?v=20260723-12"></script>
  </body>
</html>
