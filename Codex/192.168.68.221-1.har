            "text": "{\"result\":\"ok\"\n,\n\"data\":\n{\"main_nav\":[{\"ko_text\":\"코딩\",\"en_text\":\"Encoder\",\"th_text\":\"การเข้ารหัส\",\"zh_text\":\"编码\",\"href\":\"\\/encoder\",\"ru_text\":\"Кодер\",\"mode\":\"encoder\"},{\"ko_text\":\"디코딩\",\"en_text\":\"Decoder\",\"th_text\":\"ถอดรหัส\",\"zh_text\":\"解码\",\"href\":\"\\/decoder\",\"ru_text\":\"Декодер\",\"mode\":\"decoder\"},{\"ko_text\":\"인터넷\",\"en_text\":\"Network\",\"th_text\":\"เครือข่าย\",\"zh_text\":\"网络\",\"href\":\"\\/networksetup\",\"ru_text\":\"Сеть\"},{\"ko_text\":\"디스커버리 서버\",\"en_text\":\"Discovery Server\",\"th_text\":\"เซิร์ฟเวอร์การค้นพบ\",\"zh_text\":\"发现服务器\",\"href\":\"discoveryServer\",\"ru_text\":\"Сервер обнаружения\"},{\"ko_text\":\"Voice Intercom\",\"en_text\":\"Voice Intercom\",\"th_text\":\"Voice Intercom\",\"zh_text\":\"语音对讲\",\"href\":\"voiceIntercom\",\"ru_text\":\"Интерком\"},{\"ko_text\":\"KiloLink Server\",\"en_text\":\"KiloLink Server\",\"th_text\":\"KiloLink Server\",\"zh_text\":\"KiloLink Server\",\"href\":\"kilolink\",\"ru_text\":\"Сервер KiloLink\"}],\"sys_nav\":[{\"ko_text\":\"사용자 관리\",\"en_text\":\"Manage Users\",\"th_text\":\"การจัดการผู้ใช้\",\"zh_text\":\"用户管理\",\"href\":\"\\/users\",\"ru_text\":\"Пользователи\"},{\"ko_text\":\"시스템 시간\",\"en_text\":\"System Time\",\"th_text\":\"เวลาของระบบ\",\"zh_text\":\"系统时间\",\"href\":\"system-time\",\"ru_text\":\"Системное время\"},{\"ko_text\":\"Picture Management\",\"en_text\":\"Picture Management\",\"th_text\":\"Picture Management\",\"zh_text\":\"图片管理\",\"href\":\"\\/picManage\",\"ru_text\":\"Изображения\"},{\"ko_text\":\"빠른 재 연결\",\"en_text\":\"Reconnect\",\"th_text\":\"เชื่อมต่อใหม่อย่างรวดเร็ว\",\"zh_text\":\"快速重连\",\"href\":\"reset\",\"ru_text\":\"Переподключение\"},{\"ko_text\":\"장치 다시 시작\",\"en_text\":\"Reboot\",\"th_text\":\"รีสตาร์ทอุปกรณ์\",\"zh_text\":\"设备重启\",\"href\":\"reboot\",\"ru_text\":\"Перезагрузка\"},{\"ko_text\":\"초기화\",\"en_text\":\"Reset Factory Settings\",\"th_text\":\"รีเซ็ต\",\"zh_text\":\"恢复出厂设置\",\"href\":\"restore\",\"ru_text\":\"Настройки по умолчанию\"},{\"ko_text\":\"펌웨어 업그레이드\",\"en_text\":\"Firmware Update\",\"th_text\":\"อัพเกรดเฟิร์มแวร์\",\"zh_text\":\"固件升级\",\"href\":\"\\/firmwareudp\",\"ru_text\":\"Обновление прошивки\"}]}\n}\n"
